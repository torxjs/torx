{
   "name": "torx",
   "version": "2.0.0",
   "description": "The TypeScript template engine for Node.",
   "license": "MIT",
   "author": {
      "name": "Stephen Ullom",
      "url": "http://stephenullom.com"
   },
   "homepage": "http://torxjs.com/",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/torxjs/torx.git"
   },
   "bugs": {
      "url": "https://github.com/torxjs/torx/issues"
   },
   "keywords": [
      "template engine",
      "typescript",
      "javascript",
      "torx"
   ],
   "main": "dist/index.js",
   "types": "dist/index.d.ts",
   "bin": {
      "torx": "dist/cli.js"
   },
   "scripts": {
      "start": "node ./dist/cli.js",
      "build": "tsc",
      "test": "jest",
      "test:watch": "jest --watchAll --verbose",
      "pretty": "npx prettier --write .",
      "prepublishOnly": "npm run build && npm test"
   },
   "files": [
      "dist"
   ],
   "dependencies": {
      "typescript": "^5.9.3"
   },
   "prettier": {
      "tabWidth": 3,
      "printWidth": 120,
      "arrowParens": "avoid",
      "trailingComma": "all"
   },
   "jest": {
      "preset": "ts-jest",
      "testEnvironment": "node",
      "rootDir": "lib"
   },
   "devDependencies": {
      "@types/jest": "^29.5.14",
      "@types/node": "^22.0.0",
      "jest": "^29.7.0",
      "ts-jest": "^29.4.0"
   },
   "engines": {
      "node": ">=16"
   }
}
